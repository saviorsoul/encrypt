{
  "name": "encrypt",
  "version": "0.5.2",
  "private": true,
  "homepage": "https://saviorsoul.github.io/encrypt",
  "bugs": "https://github.com/saviorsoul/encrypt/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/saviorsoul/encrypt"
  },
  "author": "saviorsoul <artur.banka@gmail.com> (https://github.com/saviorsoul)",
  "license": "MIT",
  "keywords": [
    "encrypt",
    "encryption",
    "cryptography"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/feednt",
    "apps/feednt/local",
    "apps/feednt/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @encrypt/web",
    "start": "npm run start -w @encrypt/web",
    "build": "npm run build -w @encrypt/web",
    "build:pages": "npm run build:pages -w @encrypt/web",
    "preview": "npm run preview -w @encrypt/web",
    "electron:dev": "npm run electron:dev -w @encrypt/web",
    "electron:preview": "npm run electron:preview -w @encrypt/web",
    "electron:run": "npm run electron:run -w @encrypt/web",
    "electron:build": "npm run electron:build -w @encrypt/web",
    "electron:package": "npm run electron:package -w @encrypt/web",
    "dev:extension": "npm run build -w @encrypt/extension",
    "build:extension": "npm run build -w @encrypt/extension",
    "test": "npm run test -w @encrypt/web -- run && npm run test -w @encrypt/api",
    "test:protocol": "npm run test:protocol -w @encrypt/web",
    "lint": "eslint apps/web apps/api apps/feed-lab apps/feednt apps/landing-page apps/mobile apps/extension packages/core packages/schemas packages/ui packages/csp packages/platform",
    "lint:fix": "eslint apps/web apps/api apps/feed-lab apps/feednt apps/landing-page apps/mobile apps/extension packages/core packages/schemas packages/ui packages/csp packages/platform --fix",
    "format": "prettier --write apps/web apps/api apps/feed-lab apps/feednt apps/landing-page apps/mobile apps/extension packages/core packages/schemas packages/ui packages/csp packages/platform",
    "format:check": "prettier --check apps/web apps/api apps/feed-lab apps/feednt apps/landing-page apps/mobile apps/extension packages/core packages/schemas packages/ui packages/csp packages/platform",
    "dev:api": "npm run dev -w @encrypt/api",
    "dev:lab": "npm run dev -w @encrypt/feed-lab",
    "dev:feednt": "npm run dev -w @feednt/app",
    "dev:feednt:local": "npm run electron:dev -w @feednt/local",
    "feednt:electron:preview": "npm run electron:preview -w @feednt/local",
    "feednt:electron:run": "npm run electron:run -w @feednt/local",
    "feednt:electron:build": "npm run electron:build -w @feednt/local",
    "feednt:electron:package": "npm run electron:package -w @feednt/local",
    "dev:feednt:mobile": "npm run dev -w @feednt/mobile",
    "build:feednt": "npm run build -w @feednt/app && npm run build -w @feednt/local && npm run build -w @feednt/mobile",
    "feednt:mobile:sync": "npm run build -w @feednt/mobile && npm run cap:sync -w @feednt/mobile",
    "feednt:mobile:open:android": "npm run cap:open:android -w @feednt/mobile",
    "feednt:mobile:open:ios": "npm run cap:open:ios -w @feednt/mobile",
    "dev:landing": "npm run dev -w @encrypt/landing-page",
    "build:landing": "npm run build -w @encrypt/landing-page",
    "test:landing:e2e": "npm run test:e2e -w @encrypt/landing-page",
    "test:lab:e2e": "npm run test:e2e -w @encrypt/feed-lab",
    "dev:mobile": "npm run dev -w @encrypt/mobile",
    "build:mobile": "npm run build -w @encrypt/mobile",
    "mobile:sync": "npm run build:mobile && npm run cap:sync -w @encrypt/mobile",
    "mobile:open:android": "npm run cap:open:android -w @encrypt/mobile",
    "mobile:open:ios": "npm run cap:open:ios -w @encrypt/mobile",
    "dev:stack": "docker compose --env-file .env.docker up -d",
    "dev:stack:build": "docker compose --env-file .env.docker up -d --build",
    "dev:stack:logs": "docker compose --env-file .env.docker logs -f",
    "docker:down": "docker compose --env-file .env.docker down",
    "db:migrate": "npm run migrate -w @encrypt/api",
    "db:citus:distribute": "npm run db:citus:distribute -w @encrypt/api",
    "db:seed": "npm run db:seed -w @encrypt/api",
    "db:seed:friendship": "npm run db:seed:friendship -w @encrypt/api",
    "db:seed:e2e": "npm run db:seed:e2e -w @encrypt/api",
    "db:setup": "npm run db:setup -w @encrypt/api",
    "db:setup:postgres": "npm run db:setup:postgres -w @encrypt/api",
    "postinstall": "npm run postinstall -w @encrypt/api --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  }
}
