# Copy to .env for local development (repo root):
#   cp .env.example .env
#
# Docker Compose uses .env.docker
# Electron builds use .env.electron

# --- Citus / Docker ---
POSTGRES_USER=encrypt
POSTGRES_PASSWORD=encrypt
POSTGRES_DB=encrypt_feed
POSTGRES_PORT=5432

# --- API ---
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://encrypt:encrypt@localhost:5432/encrypt_feed
REDIS_URL=redis://localhost:6379

# Multiple origins: comma-separated (spaces around commas are trimmed).
# CORS_ALLOWED_ORIGINS=https://project-ef3884e2-07da-4a36-9eb-feed-lab.storage.googleapis.com,http://localhost:5174
CORS_PREFLIGHT_MAX_AGE_SECONDS=86400

# --- feed-lab / web (Vite; only VITE_* is exposed to the client) ---
# Dev: leave VITE_API_URL unset so feed-lab calls /api on the same host (Vite proxy).
# Set VITE_PROXY_TARGET to where the dev server proxies /api (e.g. http://api:3000 in Docker).
# Production static builds: set VITE_API_URL to the public API origin if different from feed-lab.
# VITE_API_URL=https://api.example.com
VITE_PROXY_TARGET=http://localhost:3000

# Feed Lab bridge callback allowlist (Electron shell:open-external + deep-link validation)
# Production defaults: feednt.com with hash-router (#/bridge-callback). Dev also allows localhost.
VITE_FEED_LAB_HOSTNAME=feednt.com
# Comma-separated dev hostnames (optional; private LAN IPs like 192.168.x.x are also allowed automatically).
VITE_FEED_LAB_DEV_HOSTNAME=localhost
VITE_FEED_LAB_HASH_ROUTER=true

# Feed Lab encrypt:// protocol bridge (feed-pair / feed-op). Off by default — use
# private key file in the browser unless you explicitly enable system-app bridge.
# VITE_FEED_LAB_PROTOCOL_BRIDGE=true

# FEED_LAB_DEV_HTTPS=true

# Keep the bridge callback tab open after redirect (for manual testing/debugging).
# VITE_FEED_LAB_KEEP_CALLBACK_TAB=true
