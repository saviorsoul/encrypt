{
  "manifest_version": 3,
  "name": "Encrypt",
  "version": "0.3.4",
  "description": "Encrypt page selections with the Encrypt desktop app via encrypt:// deep links.",
  "permissions": [
    "contextMenus",
    "commands",
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Encrypt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "encrypt-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Encrypt selection"
    },
    "import-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Decrypt selection"
    },
    "copy-public-key": {
      "description": "Public key into clipboard"
    }
  }
}
