# Copy to .env for local development (repo root):
#   cp .env.example .env
#
# Docker Compose uses .env.docker (committed defaults).
# Electron builds use .env.electron (committed).

# --- Citus / Docker ---
POSTGRES_USER=encrypt
POSTGRES_PASSWORD=encrypt
POSTGRES_DB=encrypt_feed
POSTGRES_PORT=5432

# --- API ---
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://encrypt:encrypt@localhost:5432/encrypt_feed
REDIS_URL=redis://localhost:6379

# Comma-separated origins (spaces around commas are trimmed).
# Include http://localhost for Capacitor WebView when using Feednt on Android.
# CORS_ALLOWED_ORIGINS=http://localhost:5174,https://localhost:5174,http://localhost
CORS_PREFLIGHT_MAX_AGE_SECONDS=86400

# --- VITE_API_URL ---
# API origin for Vite client apps. Only VITE_* variables are exposed to the browser/WebView.
#
# | App / target              | VITE_API_URL                         |
# |---------------------------|--------------------------------------|
# | feed-lab (browser dev)    | unset — same-origin /api via proxy   |
# | feed-lab (static build)   | public API origin if not same host   |
# | Feednt Electron (dev)     | unset — Vite proxy (dev:feednt:local)|
# | Feednt Capacitor Android  | http://<your-lan-ip>:3000 (required) |
# | Feednt (production)       | public API origin                    |
#
# Examples:
# VITE_API_URL=http://192.168.0.235:3000
# VITE_API_URL=https://api.example.com
#
# Where the dev server proxies /api when VITE_API_URL is unset (host dev or Docker: http://api:3000).
VITE_PROXY_TARGET=http://localhost:3000

# --- feed-lab ---
# Bridge callback allowlist (Electron shell:open-external + deep-link validation).
VITE_FEED_LAB_HOSTNAME=feednt.com
# Comma-separated dev hostnames (private LAN IPs like 192.168.x.x are also allowed automatically).
VITE_FEED_LAB_DEV_HOSTNAME=localhost
VITE_FEED_LAB_HASH_ROUTER=true

# encrypt:// protocol bridge (feed-pair / feed-op). Off by default.
# VITE_FEED_LAB_PROTOCOL_BRIDGE=true

# FEED_LAB_DEV_HTTPS=true

# Keep the bridge callback tab open after redirect (manual testing).
# VITE_FEED_LAB_KEEP_CALLBACK_TAB=true

# --- Feednt native (Capacitor) ---
# Force http://localhost page origin when the API uses plain HTTP (mixed-content workaround).
# Usually automatic when VITE_API_URL is http://.
# FEEDNT_ANDROID_HTTP_SCHEME=true
