{
  "name": "@encrypt/desktop",
  "version": "0.5.9",
  "private": true,
  "description": "Desktop app for Encrypt",
  "author": "saviorsoul <artur.banka@gmail.com> (https://github.com/saviorsoul)",
  "license": "MIT",
  "homepage": "https://saviorsoul.github.io/encrypt",
  "bugs": "https://github.com/saviorsoul/encrypt/issues",
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "com.encrypt.app",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && node scripts/electron-dev.mjs\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:electron": "npm run build",
    "electron:dev": "npm run dev",
    "electron:preview": "npm run build && node scripts/electron-run.mjs",
    "electron:run": "node scripts/electron-run.mjs",
    "electron:build": "npm run build && electron-builder",
    "electron:package": "electron-builder --publish never",
    "test:protocol": "vitest run tests/electron && node scripts/check-encrypt-protocol.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@encrypt/core": "*",
    "@encrypt/platform": "*",
    "@encrypt/ui": "*",
    "@encrypt/web": "*",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.30.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron": "43.2.0",
    "electron-builder": "~26.15.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.encrypt.app",
    "productName": "Encrypt",
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "extraMetadata": {
      "name": "encrypt",
      "main": "electron/main.js"
    },
    "icon": "electron/icons",
    "protocols": [
      {
        "name": "Encrypt",
        "schemes": [
          "encrypt"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "json",
          "jwk"
        ],
        "mimeType": "application/json",
        "name": "JSON",
        "description": "Encrypt message or key file"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "encrypt",
          "MimeType": "x-scheme-handler/encrypt;"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
